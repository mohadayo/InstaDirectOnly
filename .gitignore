# macOS
.DS_Store
*.swp
.AppleDouble
.LSOverride

# Xcode
build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.xcscmblueprint
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
.swiftpm/
.build/
Package.resolved
Packages/

# CocoaPods (使っていない場合も将来のために)
Pods/

# Carthage
Carthage/Build/
Carthage/Checkouts/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Editor / OS
.idea/
.vscode/
*.iml

# ------------------------------------------------------------------------------
# macOS 追加メタデータ
#   FAT / exFAT / SMB 経由でファイルを扱った際に生成される AppleDouble
#   (`._*`)、Spotlight / Trash / fsevents / DocumentRevisions といった
#   macOS システムメタデータを除外する。
# ------------------------------------------------------------------------------
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.DocumentRevisions-V100

# ------------------------------------------------------------------------------
# Windows メタデータ
#   Windows 環境で zip などを介してチェックアウトした際に紛れる
#   サムネイル / フォルダ設定ファイルを除外する。
# ------------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# 環境変数 / ローカル秘匿設定
#   ローカル開発でのみ使う設定 (API キー等) を誤って公開しないための
#   セーフティネット。`.env` は必ずしも本プロジェクトで使用中ではないが、
#   将来のスクリプト連携 (fastlane / CI ヘルパ) を見越して先に除外しておく。
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.envrc.local

# ------------------------------------------------------------------------------
# ログ
#   ローカルで生成されるログを除外。実際にリポジトリで管理したいログが
#   出た場合は個別に `!path/to/keep.log` で許可すること。
# ------------------------------------------------------------------------------
*.log
logs/

# ------------------------------------------------------------------------------
# マージコンフリクト・パッチ残骸
#   `git merge` / `git apply --reject` などで生成される一時ファイル。
# ------------------------------------------------------------------------------
*.orig
*.rej

# ------------------------------------------------------------------------------
# Xcode テスト成果物
#   `xcodebuild test` (Makefile の `test` ターゲット) が生成する
#   `*.xcresult` バンドル。ローカル解析用途のためコミット対象外とする。
# ------------------------------------------------------------------------------
*.xcresult

# ------------------------------------------------------------------------------
# Ruby / Bundler
#   将来 fastlane を導入した場合に `bundle install --path vendor/bundle`
#   で生成されるディレクトリを事前に除外しておく。
# ------------------------------------------------------------------------------
.bundle/
vendor/bundle/

# ------------------------------------------------------------------------------
# JetBrains 個別プロジェクトファイル
#   `.idea/` は上部で除外済みだが、AppCode などが `.idea/` の外に
#   出力するプロジェクトファイル (`*.iws` / `*.ipr`) も明示的に除外する。
# ------------------------------------------------------------------------------
*.iws
*.ipr

# ------------------------------------------------------------------------------
# エージェント CLI ローカル状態
#   Claude Code などのエージェント CLI が作業ディレクトリに生成する
#   ローカル状態ディレクトリ。ユーザ固有の履歴のためコミット対象外。
# ------------------------------------------------------------------------------
.claude/
