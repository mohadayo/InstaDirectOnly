// markdownlint-cli2 設定ファイル
//
// 目的:
//   リポジトリ配下の Markdown ドキュメント群の構造上の問題
//   （見出し階層の飛び・リスト記法の不統一・空行の欠落など）を
//   継続的に検知する。
//
// 方針:
//   - 日本語ドキュメントが中心のため、英語前提のスタイルルールは
//     緩める（行長・箇条書き末尾の句点・インライン HTML など）。
//   - 構造上の問題を重視するため、見出し・リスト・コードブロック
//     周辺のルールは原則有効のまま維持する。
//   - 自動生成物 (`node_modules/`) と履歴型ファイル (`CHANGELOG.md`)
//     は検査対象から除外する。
{
  "config": {
    "default": true,
    // 行長制限: 日本語の長文を阻害するため無効化
    "MD013": false,
    // 同名見出し: 兄弟階層間だけ重複禁止（親子間は許可）
    "MD024": { "siblings_only": true },
    // 見出し末尾の句読点: 日本語の「。」等を許容するため無効化
    "MD026": false,
    // インライン HTML: <details>/<summary> 等の使用を許可
    "MD033": false,
    // 裸 URL: 参考 URL の直接掲載を許可
    "MD034": false,
    // 見出しとして装飾を使う: 本文中の **強調** 誤検知を避けるため無効化
    "MD036": false,
    // コードブロックの言語指定: プレーンテキストブロック用途が多いため任意
    "MD040": false,
    // 最初の行が見出しでない: タイトル直前の注記等を許可
    "MD041": false,
    // 見出し階層の飛び: 要約節等で h2 → h4 を許容する運用のため無効化
    "MD001": false
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules/**",
    ".git/**",
    "CHANGELOG.md"
  ]
}
